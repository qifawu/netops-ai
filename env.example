# 复制成 .env 再填：cp env.example .env
# .env 在 .gitignore 里，不会进仓库。
# （文件名没带前导点，是因为 Mac 这边的权限规则拦 .env* 开头的文件。）
#
# Zabbix 自己那套容器环境变量在 deploy/zabbix/.env，跟这个分开。

# ---- Zabbix（只读接入）----------------------------------------------------
# 8880 不是 8080——EVE-NG guest 的 8080 可能被它自己的 Tomcat/Guacamole 占着
ZABBIX_URL=http://<zabbix-host>:8880
ZABBIX_USER=<zabbix-readonly-user>
ZABBIX_PASSWORD=

# ---- 设备（只读账号，不是管理员账号）--------------------------------------
# 这个账号在设备上必须是只读权限（Cisco privilege 1）。
# 代码里的命令白名单是第一层，这个账号是第二层，两层都要有。
DEVICE_USERNAME=<device-readonly-user>
DEVICE_PASSWORD=
# S2 阶段设备选型定了用 Cisco vIOS（起得快、稳、SNMP好配，其它厂商也支持，见 whitelist.py）
DEVICE_VENDOR=<vendor>
DEVICE_HOST=<device-host>
# 默认走 SSH；只有 console/应急路径才显式改成 telnet。
DEVICE_TRANSPORT=ssh
DEVICE_PORT=22
# telnet 是明文协议，生产环境只应该出现在 console 线这类应急/带外场景。
# 显式设置 DEVICE_TRANSPORT=telnet 才会使用这个端口。
DEVICE_TELNET_PORT=23

# ---- syslog ----
# 起不再由我们 SSH 去读 syslog 文件（A14）。设备 → rsyslog（EVE-NG guest 上
# /var/log/network/<IP>.log，**这批文件别删**）→ Zabbix `logrt[]` 监控项，agent 从 Zabbix 查。


# ---- 定时任务 ----
# 每隔多少分钟跑一轮：巡检 + 给拓扑里每台设备存一份配置（当下次告警的「故障前」）。
# 不配或 0 就不开。处置建议要调模型花钱，不在定时任务里跑。
# 不等周期、立刻跑一轮：POST /api/schedule/run
SCHEDULE_INTERVAL_MINUTES=60

# ---- 大模型 ---------------------------------------------------------------
# LLM_PROVIDER 可选；不填时按 LLM_BASE_URL 自动识别。
# 合法值：
# - gemini:native / gemini-native：Google Gemini 原生协议，支持多轮工具签名回放。
# - gemini:openai / gemini-openai：Google Gemini OpenAI 兼容层；2.5+ thinking 模型可能丢 thought_signature。
# - openai、deepseek、anthropic、openai-compatible：按对应端点/通用 OpenAI 兼容处理。
# 判断优先级：LLM_PROVIDER 显式配置永远赢；否则用 LLM_BASE_URL；API key 前缀只做告警。
LLM_PROVIDER=
# 默认不关闭 thinking。只在实测 Gemini OpenAI 兼容层绕路时设 true；这可能修好管道但牺牲多跳推理能力。
LLM_DISABLE_GEMINI_OPENAI_THINKING=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 两台机器统一用阿里云百炼（起）。只有 key 是秘密，另外两行照抄：
#   LLM_BASE_URL=https://ws-nnpcnmi1ssfizllf.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen3.8-flash
# 这个工作空间只授权了 qwen3.8-flash。思考模式由 llm/client.py 对 aliyuncs.com 自动关掉，不用配。
# key 存在各自机器的仓库外位置（Mac：~/netops-lab-services/aliyun-bailian-apikey.csv），不进仓库。

# ---- 飞书上报（M3 才用得上）-----------------------------------------------
# 两条通道二选一，都配了走 webhook（webhook 不需要 app secret 落在这台机器上）。
#
# 通道一：群自定义机器人 webhook。只能在飞书群设置里人工点出来，没有 API 能建。
FEISHU_WEBHOOK_URL=
#
# 通道二：应用身份。用 Mac 侧 ~/lark-self-study 那套 lark-cli 已经配好的应用，
# 群和机器人都现成的（群 ID 填到 FEISHU_CHAT_ID）。
# FEISHU_APP_SECRET 是凭据：不进仓库，但**必须**同时写进这台机器上一个固定的
# 仓库外位置（见 docs/LAB-ENV.md「凭据放哪」），不能只留在临时目录里。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# 同主机告警收敛窗口（秒）：首条告警立即发轻量回执卡，完整结论等窗口关闭后再发。
# 这两个数字不是占位值——N1 那轮真实测量了这台 lab 的协议 timer：OSPF dead
# interval 40s、BGP hold time 180s、Zabbix 邻居状态监控项轮询间隔 30s
# （内部文档）。协议级联最长那条链是 BGP：接口 down 后最多
# 等满 180s hold time 才会判定邻居丢失，再等最多一个轮询周期 30s 才被 Zabbix
# 采到，合计 210s；220s 是留了 10s 余量，300s 硬上限防止异常配置下永远不出结论。
# 换了协议 timer 配置（比如把 BGP hold time 调短）之后，这两个数字要跟着重新
# 测量校准，不要凭感觉改。
ALERT_WINDOW_SECONDS=220
ALERT_WINDOW_MAX_SECONDS=300

# 静默这么久没有新告警进来，就提前关窗（加）。
# 一刀切等满 220s 是按最慢的 BGP 级联定的，接口 down 那种秒级到齐的纯属陪跑。
# 现在的规则是：关窗时刻 = max(现在 + 静默时间, 开窗 + 最短等待)，被硬上限截断，
# 每来一条新告警就重排一次。孤立告警 40s 就出结果；级联还在来就一直往后延。
# 「最短等待」按告警类型算（BGP 210s / OSPF 60s / 其余 0），写死在
# `netops_ai/api/pipeline.py` 的 `MIN_WAIT_BY_KEYWORD`，不走环境变量——
# 那是协议 timer 决定的，跟部署环境无关。
ALERT_WINDOW_QUIET_SECONDS=40

# ─────────────────────────────────────────────────────────────────────
# Token 计量与经济性核算（netops_ai/llm/meter.py）
# ─────────────────────────────────────────────────────────────────────
#
# 这套东西要回答的是：「你烧这么多 token 才做个自动化，我多雇个 NOC 不就完了？」
# 光报 token 数量回答不了，必须一路算到钱，并和人工成本摆在一起。
#
# 实测（14 条真实归档告警，tiktoken 计数）：单次调用输入中位数 8101 token，
# 其中 **JSON schema 占 5454（67%）**——每次调用都要重发一遍的固定开销。
# Zabbix 数据 2226（27%），设备输出只有 426（5%）。
#
# 按 4 跳循环（每跳重发全量上下文）估算的单条告警成本，对比人工 ¥6.16：
#   deepseek          ¥0.19   1/33   ✅
#   gemini-2.5-flash  ¥0.25   1/25   ✅
#   claude-sonnet-5   ¥2.16   1/3    ⚠️  优势变薄
#   claude-opus-5     ¥10.82  比人工还贵 ❌
#
# **所以选哪个模型不是调优细节，是这套东西经济上成不成立的决定因素。**

# 单次 agent 循环的 token 上限（prompt + completion 累计）。超了就带着已有
# 证据出残缺结论，不是继续烧——已经花掉的 token 不能白花。0 或留空 = 不限。
#
# 为什么轮数上限（max_iterations）不够用：多跳循环每跳都把全量对话历史重发
# 一遍，4 跳 × 20k 上下文就是 80k 而不是 20k。轮数数的是次数，不是体积。
#
# **修正**：这个变量在此之前是摆设——TokenBudget 那个类写好了、
# 有单测、这里也写了，但全仓库没有任何运行代码 import 过它，真正兜住失控
# 循环的一直是 max_iterations。现在接在 agent_loop.AgentLoopBudget 上了，
# tests/test_token_budget_wired.py 里有一组在真 run_agent_loop 里跑的测试
# 锁住这条接线。
ANALYSIS_TOKEN_BUDGET=60000

# 账本落盘位置（append-only jsonl，已 gitignore）
# TOKEN_LEDGER_PATH=records/token-ledger.jsonl

# 用真实账单单价覆盖内置价格表（美元/百万 token）。内置的是公开列表价，
# 不含你的折扣和缓存命中折扣，只适合估算。
# 研判 prompt 的硬上限（字符），超了截断并说明，默认 120000。
# 撞到：52 条候选 × 21.6 万字符，模型直接以「输入超长」400 掉，整个 incident 没结论。
# ANALYSIS_PROMPT_MAX_CHARS=120000

# LLM_PRICE_INPUT_USD_PER_M=0.30
# LLM_PRICE_OUTPUT_USD_PER_M=2.50
# USD_CNY_RATE=7.1


# ---- NetBox（拓扑和台账的真源，可选）----------------------------------------
# 配了就从 NetBox 读拓扑，没配就读版本化的 topology.yaml。两者结构完全一样。
# **NetBox 4.7 起 token 是 v2 格式**：这里填 `nbt_<key>.<plaintext>` 全串，
# 代码按前缀自动选 `Bearer`（v2）还是 `Token`（v1）。照旧文档只填 key 会一直 403。
# 只读即可，我们这侧没有任何写入路径。
NETBOX_URL=
NETBOX_TOKEN=


